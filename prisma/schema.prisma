// Flux — Prisma schema
// Data model per CLAUDE.md "Data Model (starting point)".
// Prisma 7: new `prisma-client` generator (TS client emitted to a custom output dir).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7: connection URLs live in prisma.config.ts (datasource.url), not here.
  // The runtime PrismaClient connects via a driver adapter (see src/lib/db.ts).
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  ADMIN
  EXECUTIVE
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER
}

enum TaskType {
  TASK
  BUG
  STORY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────────────────────────────────
// Core entities
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(cuid())
  name              String
  // Stored lowercase-normalised; format validation happens in Zod at the boundary.
  username          String     @unique
  email             String     @unique
  hashedPassword    String?
  globalRole        GlobalRole @default(USER)
  status            UserStatus @default(ACTIVE)
  bio               String?
  avatarKey         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tourCompletedAt   DateTime?
  /// Whether this user appears on the /display office wall board.
  /// Admin-configurable at /admin/display. Defaults true so a new joiner shows
  /// up without anyone remembering to enable them; the bootstrap @admin account
  /// is switched off by the migration that adds this column.
  showOnWallBoard   Boolean    @default(true)
  // Watermark for session revocation: a JWT issued before this instant is no
  // longer honoured (see requireUser in lib/permissions.ts). Null until the
  // user's first password reset.
  passwordChangedAt DateTime?

  // Relations
  projectsLed         Project[]            @relation("ProjectLead")
  memberships         ProjectMembership[]
  invitesSent         Invite[]             @relation("InviteInvitedBy")
  assignedTasks       Task[]               @relation("TaskAssignee")
  reportedTasks       Task[]               @relation("TaskReporter")
  comments            Comment[]
  commentReactions    CommentReaction[]
  attachments         Attachment[]
  auditLogs           AuditLog[]
  activityLogs        ActivityLog[]
  notifications       Notification[]       @relation("NotificationRecipient")
  actedNotifications  Notification[]       @relation("NotificationActor")
  watchedTasks        TaskWatcher[]
  savedViews          SavedView[]
  timeEntries         TimeEntry[]
  apiKeys             ApiKey[]             @relation("ApiKeyActor")
  apiKeysCreated      ApiKey[]             @relation("ApiKeyCreatedBy")
  managedTeams        Team[]               @relation("TeamManager")
  teamMemberships     TeamMembership[]
  projectLeads        ProjectLead[]
  savedFilters        SavedFilter[]
  passwordResetTokens PasswordResetToken[]
  displayTokens       DisplayToken[]       @relation("DisplayTokenCreatedBy")
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  leadId      String
  // Per-project incrementing counter for task keys (<KEY>-<n>); bumped atomically in a tx.
  taskCounter Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Never hard-delete a user who leads a project.
  lead            User                @relation("ProjectLead", fields: [leadId], references: [id], onDelete: Restrict)
  memberships     ProjectMembership[]
  tasks           Task[]
  labels          Label[]
  savedViews      SavedView[]
  teams           TeamProject[]
  additionalLeads ProjectLead[]

  @@index([leadId])
}

model ProjectMembership {
  id          String       @id @default(cuid())
  projectId   String
  userId      String
  projectRole ProjectRole
  manualRole  ProjectRole?
  createdAt   DateTime     @default(now())

  // Deleting a project cascades its memberships; users are never hard-deleted.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
}

model Invite {
  id                 String     @id @default(cuid())
  email              String
  intendedGlobalRole GlobalRole @default(USER)
  tokenHash          String     @unique
  invitedById        String
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime   @default(now())

  invitedBy User @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([invitedById])
}

/// Single-use, expiring password-reset token. Only the SHA-256 hash of the
/// token is stored — the raw value exists solely in the email we send, so a
/// database leak yields nothing usable. Same contract as Invite.tokenHash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id             String       @id @default(cuid())
  projectId      String
  key            String       @unique
  title          String
  // Sanitised HTML (project's chosen rich-text persistence format).
  description    String?
  type           TaskType     @default(TASK)
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?
  reporterId     String
  parentId       String?
  // Fractional-index / midpoint ordering value for the board.
  position       Float
  dueDate        DateTime?
  estimatedHours Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Deleting a project cascades its tasks.
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Users are never hard-deleted, so assignee/reporter are Restrict.
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  reporter      User           @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  // Self-relation for subtasks: deleting a parent sets its children's parentId to null.
  parent        Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  subtasks      Task[]         @relation("Subtasks")
  labels        Label[]
  comments      Comment[]
  attachments   Attachment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  watchers      TaskWatcher[]
  timeEntries   TimeEntry[]

  @@index([projectId, status, position])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([parentId])
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String

  // Deleting a project cascades its labels.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  // Sanitised HTML.
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments Attachment[]
  reactions   CommentReaction[]

  @@index([taskId])
  @@index([authorId])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

model Attachment {
  id          String   @id @default(cuid())
  taskId      String
  // When set, this attachment belongs to a comment (file list + inline images);
  // null means a task-level attachment OR a composer "draft" not yet posted.
  // `taskId` stays required regardless, so project/task-delete R2 cleanup that
  // filters by task keeps covering comment attachments too.
  commentId   String?
  uploaderId  String
  // R2 object key — never exposed directly; served via presigned URLs.
  key         String
  filename    String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([commentId])
  @@index([uploaderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([actorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications & watchers (in-app notification centre)
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_MENTIONED
  TASK_STATUS_CHANGED
  TASK_WATCHER_ADDED
}

model Notification {
  id        String           @id @default(cuid())
  // Recipient.
  userId    String
  type      NotificationType
  taskId    String?
  // Who caused it (nullable so a deleted actor doesn't cascade the notice away).
  actorId   String?
  // Free-form context (task key/title snapshot, old/new status, comment id, …).
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  // Unread-first feed per user; readAt null sorts as "unread".
  @@index([userId, readAt, createdAt])
}

model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved filter views (backlog)
// ─────────────────────────────────────────────────────────────────────────────

model SavedView {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  name      String
  // Serialised URL search string of the backlog's filters + sort, e.g.
  // "status=TODO&priority=HIGH&sort=priority&dir=desc". Applied verbatim as
  // `?<query>` when the view is selected.
  query     String
  createdAt DateTime @default(now())

  // Personal, per-user views: deleting the user or the project takes the view with it.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // A user can't have two views with the same name in the same project.
  @@unique([userId, projectId, name])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Time tracking
// ─────────────────────────────────────────────────────────────────────────────

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startedAt DateTime
  endedAt   DateTime? // null = running
  minutes   Int? // set on stop: round((endedAt-startedAt)/60000), min 1
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, endedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agent API keys
// ─────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  userId      String
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User @relation("ApiKeyActor", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("ApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Teams org foundation (Team / Lead / access-sync)
// ─────────────────────────────────────────────────────────────────────────────

model Team {
  id                        String   @id @default(cuid())
  name                      String
  description               String?
  isActive                  Boolean  @default(true)
  managerId                 String?
  // Per-team on/off switch (default off — privacy): when true, team members can
  // see teammates' productivity on the /team view. Hard-gated server-side on
  // every read, never trusted from the client — see getTeamProductivity.
  membersCanSeeProductivity Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  manager  User?            @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members  TeamMembership[]
  projects TeamProject[]

  @@index([managerId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamProject {
  id        String      @id @default(cuid())
  teamId    String
  projectId String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([teamId, projectId])
  @@index([projectId])
}

model ProjectLead {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task Explorer (#3) — global saved filters
// ─────────────────────────────────────────────────────────────────────────────

// Per-user, global (no projectId) saved filter combo for /explore — the
// cross-project analog of SavedView. Owner-only: only the creating user can
// see or delete their own SavedFilter rows (enforced in the actions, not here).
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  // Serialised URL search string of the explorer's filters, applied verbatim
  // as `?<query>` when selected — same convention as SavedView.query.
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Product analytics — cached GA4 metrics for the admin wall board
// ─────────────────────────────────────────────────────────────────────────────

enum MetricGrain {
  // A point-in-time reading (GA4 realtime: active users in the last 30 min).
  // `periodStart` is the capture instant, truncated to the minute.
  INSTANT
  // One calendar day in the SOURCE property's timezone (Asia/Calcutta here,
  // not the office's). `periodStart` is that day's 00:00 UTC-normalised date.
  DAY
}

// A single cached metric reading pulled from an external analytics source.
//
// WHY THIS EXISTS: the office wall board refreshes every ~20s. Hitting the GA4
// Data API on every render would be ~4,300 calls/day and blow the property's
// realtime token quota. The cron sync writes here; every read path serves from
// here. That also means a Google outage shows a slightly stale number instead
// of a blank panel, and we accumulate history independent of GA4's own
// retention window.
//
// Deliberately source-agnostic (`source` + `scope`) so a second property — or
// a non-GA4 source entirely — is a config row, not a schema change.
model MetricSnapshot {
  id     String @id @default(cuid())
  // Origin system, e.g. "ga4". Paired with `scope` to disambiguate.
  source String
  // Slice within the source: "web" | "app" | "all" (platform split), so the
  // board can show website and app side by side from one property.
  scope  String
  // Metric key in OUR vocabulary, not the vendor's — e.g. "activeUsers1d".
  // Insulates the UI from GA4 metric renames.
  metric String
  value  Float

  // Optional breakdown, e.g. dimension "country" / dimensionValue "India".
  // EMPTY STRING, not null, for un-broken-down scalar rows: Postgres treats
  // NULLs as distinct in a unique index, so nullable columns here would
  // silently defeat the uniqueness that makes the sync idempotent.
  dimension      String @default("")
  dimensionValue String @default("")

  grain       MetricGrain
  // What the value DESCRIBES (see MetricGrain), not when it was fetched.
  periodStart DateTime
  // When we actually pulled it — drives the "as of HH:MM" staleness badge.
  capturedAt  DateTime    @default(now())

  // Re-running the sync for the same period must overwrite, not duplicate:
  // the sync upserts on this key, so it is safely idempotent and a retry
  // after a partial failure self-heals.
  @@unique([source, scope, metric, dimension, dimensionValue, grain, periodStart])
  // Serves the board's "last N days of metric X" reads.
  @@index([metric, grain, periodStart])
  // Serves the breakdown cards (top countries / channels / devices).
  @@index([dimension, grain, periodStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Wall-display access tokens
// ─────────────────────────────────────────────────────────────────────────────

/**
 * A signed, revocable, READ-ONLY credential for the office wall board.
 * WHY THIS EXISTS: /display is admin-gated, which would mean the mini PC
 * driving the TV holds a live admin session indefinitely — a browser nobody
 * locks, in a room anyone walks through. This grants exactly one capability
 * (render the analytics board) and can be revoked in one click without
 * touching anyone's account.
 * Mirrors ApiKey deliberately (prefix + sha256 hash, plaintext shown once,
 * revocation by timestamp) so there is one auth-credential pattern in the
 * codebase, not two.
 */
model DisplayToken {
  id          String    @id @default(cuid())
  name        String
  /**
   * First 16 chars — safe to show in listings so a token is identifiable
   * without storing anything that could be replayed.
   */
  prefix      String    @unique
  tokenHash   String    @unique
  createdById String
  lastUsedAt  DateTime?
  /**
   * Set to revoke. Never deleted, so the audit trail survives.
   */
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User @relation("DisplayTokenCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
}

/**
 * Small key/value store for operational settings that shouldn't need a deploy
 * to change — currently just the wall-board rotation period.
 * Deliberately generic and deliberately tiny: a settings TABLE per feature
 * would be heavier than the problem, and hardcoding these values is what sent
 * the wall-board visibility rules through a redeploy in the first place.
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
