# Database — local Postgres 16 (e.g. postgresql://<you>@localhost:5432/flux_dev) or hosted (Neon/Supabase).
# For Supabase use the pooled URL as DATABASE_URL and the direct URL as DIRECT_URL. For Neon both can be the same.
DATABASE_URL=""
DIRECT_URL=""
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET=""   # generate with: openssl rand -base64 32
AUTH_TRUST_HOST="true"
# Seed admin (dev/e2e only) — password the seed script assigns to it@iccadubai.ae; the e2e suite signs in with it
SEED_ADMIN_PASSWORD=""
# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="flux-attachments"
# SMTP (invite emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Flux <no-reply@foodverse.io>"
# Cron auth — shared secret the scheduler sends as `Authorization: Bearer <value>` to /api/cron/due-reminders
CRON_SECRET=""

# ── Product analytics (admin dashboard + /display wall board) ────────────────
# GA4 — property 433277300 holds web + iOS + Android streams.
# Service account needs Viewer on the property AND the Analytics Data API
# enabled on its GCP project.
GA4_PROPERTY_ID=""
GA_SA_CLIENT_EMAIL=""
GA_SA_PRIVATE_KEY=""

# Google Play installs. Play has NO installs API — the numbers are CSV exports
# in a private GCS bucket. Copy the URI from Play Console → Download reports,
# and grant the service account "View app information (Global)" in
# Play Console → Users and permissions.
# Falls back to the GA_SA_* credentials when PLAY_SA_* are unset.
PLAY_BUCKET_ID=""
PLAY_PACKAGE_NAME=""
PLAY_SA_CLIENT_EMAIL=""
PLAY_SA_PRIVATE_KEY=""

# App Store Connect (iOS downloads). Team key with Finance or Sales role.
# The .p8 downloads once — store it here with newlines escaped as \n.
ASC_ISSUER_ID=""
ASC_KEY_ID=""
ASC_PRIVATE_KEY=""
ASC_VENDOR_NUMBER=""
